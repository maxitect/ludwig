{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["lhr1"],
  "buildCommand": "pnpm db:migrate && pnpm db:seed && pnpm puzzles:top-up-dailies && pnpm build",
  "ignoreCommand": "node scripts/dev/vercel-ignore.mjs",
  "crons": [
    { "path": "/api/cron/favourite-digest", "schedule": "0 8 * * *" },
    { "path": "/api/cron/streak-nudge", "schedule": "0 17 * * *" }
  ]
}
